# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# OBRIGATÓRIO: Configure o Access Token para checkout Pix funcionar.
# Use o Access Token de TESTE no desenvolvimento e o de PRODUÇÃO no deploy.
# Sem este token, checkout retornará 503 PAYMENT_SERVICE_NOT_CONFIGURED.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx

# Obrigatório com token TEST-: e-mail do comprador em Contas de teste (…@testuser.com).
# Sem isso o MP responde "Invalid users involved".
# MP_TEST_PAYER_EMAIL=TESTUSER123@testuser.com

# E-mail padrão do pagador (fallback). Em token TEST use *@testuser.com.
# No carrinho o convidado informa o e-mail do Pix; este valor é fallback.
# MP_PAYER_EMAIL=noreply@casebem.com

# Opcional: URL fixa do webhook (senão usa Origin + /api/webhooks/mercadopago)
# MP_NOTIFICATION_URL=https://casebem.com/api/webhooks/mercadopago

# Opcional: chave pública (Brick / SDK front). Pix atual usa só o Access Token no servidor.
# VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx

# Obrigatório para checkout de presentes (HMAC / intent)
# RSVP_SECRET=base64-com-pelo-menos-32-bytes

# --- Painel dos noivos (Cloudflare Free — sem Access pago) ---
# Secret ≥16 chars. Header: Authorization: Bearer <valor>
# Login temporário na UI: usuário Dani / senha Carine → Bearer admin-local-dev-ok
ADMIN_PANEL_SECRET=admin-local-dev-ok

# --- E-mail opcional (Resend free ~3k/mês — NÃO usa produto pago Cloudflare) ---
# Se omitir, notificações são silenciosamente ignoradas (zero custo).
# RESEND_API_KEY=re_xxxxxxxx
# ADMIN_NOTIFY_EMAIL=seu-email@exemplo.com
# RESEND_FROM_EMAIL=CaseBem <onboarding@resend.dev>
